[Unit]
Description=Record actionable local PubShip backup failure (not a delivered alert)

[Service]
Type=oneshot
User=pubship-backup
Group=pubship-backup
ExecStart=/usr/bin/python3 /opt/pubship-ops/operator_backup.py report
TimeoutStartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
